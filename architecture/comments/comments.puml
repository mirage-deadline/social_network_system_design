@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "User")
Container(reverseProxy, "Reverse proxy", "Nginx")
Container(apiGateway, "API Gateway", "Golang")
ContainerQueue(comments_out, "comments_out topic", "Kafka", "Comments update events")

System_Boundary(commentsSystem, "Comments system") {
Container(commentsService, "Comments Service", "Golang", "Handle and store comments")
ContainerDb(commentsDatabase, "Comments database", "PostgreSQL", "Stores user comments",  $tags="db")
Rel(commentsService, commentsDatabase, "CRUD operations")
Rel(commentsService, comments_out, "Produce update events about comments")
}

System_Ext(analyticsSystem, "External analytics system") {
}

Rel(user, reverseProxy, "CRUD operations", "REST")
Rel(reverseProxy, apiGateway, "CRUD operations", "REST")
Rel(apiGateway, commentsService, "CRUD operations", "gRPC")

Rel(analyticsSystem, comments_out, "Comments updates")
@enduml